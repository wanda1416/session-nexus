{
  "manifest_version": 3,
  "name": "SessionNexus Bridge",
  "version": "0.1.0",
  "description": "Lets SessionNexus operate tabs in this already-signed-in browser.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SessionNexus Bridge"
  }
}
